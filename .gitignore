# Dependencies and build output — never committed on any branch.
node_modules/
.DS_Store

# Generated by scripts/build-www.js — the staged copy of the game that
# Capacitor bundles. Regenerated by `npm run www`.
www/

# Generated icon masters (scripts/make-icons.js) and its scratch page.
# The committed copies under assets/ are what @capacitor/assets reads;
# build/ is only the scratch it was rendered into.
build/
.icon-render.html

# The seeded design canvas: ~2.5MB of generated editor payload, rebuilt from
# the .dc.html sources beside it. The sources are the thing worth keeping.
.design/*.html
!.design/*.dc.html

# Capacitor copies the staged web app into each native project. `cap sync`
# regenerates both from www/, so committing them would duplicate the whole
# game twice over and churn on every change.
ios/App/App/public/
android/app/src/main/assets/public/
ios/App/App/capacitor.config.json
android/app/src/main/assets/capacitor.config.json

# Native build output.
android/app/build/
android/build/
android/.gradle/
ios/App/build/
ios/DerivedData/
*.apk
*.aab
*.ipa
